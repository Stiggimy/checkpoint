#!/usr/bin/env bash
# ==============================================================================
# checkpoint: Universal System Snapshot Manager
# ==============================================================================

VERSION="0.9.35"
BUILD="82"

# Auto-detect source directory (handles symlinks seamlessly)
detect_source_dir() {
    local script_path
    script_path="$(readlink -f "$0" 2>/dev/null || echo "$0")"
    local script_dir
    script_dir="$(dirname "$script_path")"
    if git -C "$script_dir" rev-parse --show-toplevel >/dev/null 2>&1; then
        SOURCE_DIR="$(git -C "$script_dir" rev-parse --show-toplevel)"
    else
        SOURCE_DIR="$script_dir"
    fi
}
detect_source_dir

# Ensure standard user tool directories are in PATH
for _p in "$HOME/.local/bin"; do
    [[ -d "$_p" && ":$PATH:" != *":$_p:"* ]] && PATH="$_p:$PATH"
done
unset _p

# Resolve library directory (local repo, XDG data directory, or system path).
# The legacy ~/.local/lib/checkpoint fallback lets lib/xdg.sh migrate old
# installs on the first run.
: "${XDG_DATA_HOME:=$HOME/.local/share}"
_checkpoint_data_dir="${CHECKPOINT_DATA_DIR:-$XDG_DATA_HOME/checkpoint}"
if [[ -d "$SOURCE_DIR/lib" ]]; then
    LIB_DIR="$SOURCE_DIR/lib"
elif [[ -d "$_checkpoint_data_dir/lib" ]]; then
    LIB_DIR="$_checkpoint_data_dir/lib"
elif [[ -d "$HOME/.local/lib/checkpoint" ]]; then
    LIB_DIR="$HOME/.local/lib/checkpoint"
elif [[ -d "/usr/lib/checkpoint" ]]; then
    LIB_DIR="/usr/lib/checkpoint"
else
    echo "ERROR: Could not locate Checkpoint library directory (lib/)." >&2
    exit 1
fi
unset _checkpoint_data_dir

# Load core modules
source "$LIB_DIR/xdg.sh"
source "$LIB_DIR/core.sh"
source "$LIB_DIR/config.sh"
source "$LIB_DIR/backend.sh"
source "$LIB_DIR/retry.sh"
source "$LIB_DIR/snapshot.sh"

# Execute snapshot workflow / CLI dispatcher
run_checkpoint "$@"
