pkgbase = checkpoint-git
	pkgdesc = Universal system snapshot manager supporting Snapper and Timeshift with porcelain IPC (git)
	pkgver = 0.11.5
	pkgrel = 1
	url = https://github.com/Stiggimy/checkpoint
	install = checkpoint-git.install
	arch = any
	license = GPL-3.0-or-later
	makedepends = git
	depends = bash
	depends = coreutils
	depends = findutils
	depends = gawk
	depends = grep
	depends = sed
	depends = sudo
	optdepends = fzf: interactive menus and snapshot deletion browser
	optdepends = snapper: Btrfs/Ext4 snapshot backend
	optdepends = timeshift: Btrfs/Rsync snapshot backend
	optdepends = advance: universal modular system update manager (https://github.com/Stiggimy/advance)
	optdepends = libnotify: desktop notifications for failures and background updates
	provides = checkpoint
	conflicts = checkpoint
	source = checkpoint-git::git+https://github.com/Stiggimy/checkpoint.git#branch=master
	sha256sums = SKIP

pkgname = checkpoint-git
