post_install() {
    cat <<'EOF'
Checkpoint (git package) has been installed system-wide.

  Binary:  /usr/bin/checkpoint
  Catalog: /usr/share/checkpoint/catalog/backends
  Manual:  man checkpoint

This package tracks the master branch. Rebuild it to pick up new commits.

Checkpoint detects an available backend from the catalog on first run.
Custom backends can be placed in
$XDG_CONFIG_HOME/checkpoint/backends.d (default: ~/.config/checkpoint/backends.d).

Optional extras:
  - fzf for "checkpoint config" and interactive deletion
  - snapper or timeshift for snapshot backends
  - libnotify for desktop notifications
EOF
}

post_upgrade() {
    post_install
}
